  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
